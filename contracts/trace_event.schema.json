{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainguard/contracts/trace_event.schema.json",
  "title": "TraceEvent —— 全链路留痕事件",
  "description": "Owner: D（编排与前端）｜冻结时间: 2026-11-07 22:00｜契约编号 7/10。只记摘要与摘要哈希，禁止写入 API Key、完整提示词或用户隐私文本。",
  "type": "object",
  "required": ["event_id", "trace_id", "ts", "node_id", "kind"],
  "properties": {
    "event_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "run_id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "node_id": { "type": "string" },
    "kind": {
      "enum": ["start", "end", "fail", "retry", "degrade", "revise", "abort", "checkpoint"]
    },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "attempt": { "type": "integer", "minimum": 1 },
    "round": { "type": "integer", "minimum": 0, "maximum": 3 },
    "input_digest": { "type": "string", "description": "输入摘要（sha256:... 或人读摘要），不得含敏感原文" },
    "output_digest": { "type": "string" },
    "config_version": { "type": "string", "description": "当次运行的配置版本，用于复现" },
    "error_class": { "type": "string" },
    "reason": { "type": "string" }
  },
  "additionalProperties": false
}
